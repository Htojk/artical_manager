# Copy this file to .env before running start.bat.
# None of these values may be reused from production or committed to git.

# Pinned image version (major "3" or an exact tag such as "3.94.0").
# Set an exact tag for deployments that must be reproducible.
LANGFUSE_VERSION=3
LANGFUSE_WEB_PORT=3000
# Set this to the address users will open (intranet host included).
LANGFUSE_NEXTAUTH_URL=http://localhost:3000

# --- Datastore credentials (generate random values) ---
POSTGRES_PASSWORD=change-me-postgres
REDIS_PASSWORD=change-me-redis
CLICKHOUSE_PASSWORD=change-me-clickhouse
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me-minio

# --- Langfuse secrets (generate random values) ---
# SALT: openssl rand -base64 32
SALT=change-me-salt
# ENCRYPTION_KEY: openssl rand -hex 32 (64 hex characters)
ENCRYPTION_KEY=change-me-encryption-key
# NEXTAUTH_SECRET: openssl rand -base64 32
NEXTAUTH_SECRET=change-me-nextauth-secret

# --- First-start bootstrap (only applied to an empty database) ---
LANGFUSE_INIT_ORG_ID=article-manager
LANGFUSE_INIT_ORG_NAME=Article Manager
LANGFUSE_INIT_PROJECT_ID=article-manager
LANGFUSE_INIT_PROJECT_NAME=Article Manager
# These two must match APP_LANGFUSE_PUBLIC_KEY / APP_LANGFUSE_SECRET_KEY
# in the backend .env.
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-change-me
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-change-me
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=Admin
LANGFUSE_INIT_USER_PASSWORD=change-me-admin-password
