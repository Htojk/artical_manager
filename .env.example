# Copy to .env and adjust for your machine. All keys use the APP_ prefix.

# --- Server ---
APP_ENV=local
APP_HOST=127.0.0.1
APP_PORT=8000
APP_FRONTEND_PORT=5173
APP_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# --- Storage (relative paths resolve from the project root) ---
APP_DATA_DIR=data
APP_LOG_DIR=logs
APP_SKILLS_DIR=skills
APP_PROMPTS_DIR=backend/app/prompts
# Optional overrides; defaults are data/app.sqlite and data/checkpoints.sqlite
# APP_DATABASE_URL=sqlite:///data/app.sqlite
# APP_CHECKPOINT_URL=sqlite:///data/checkpoints.sqlite

# --- Security ---
# Encrypts platform credentials at rest. If empty, data/secret.key is generated.
# Use a long random value (at least 8 chars) in any shared environment.
APP_SECRET_KEY=

# --- Workflow ---
APP_MAX_CONCURRENT_RUNS=1
APP_PUBLISH_CONFIRMATION=true
APP_MAX_REVISIONS=3
APP_REVIEW_PASS_THRESHOLD=75

# --- LLM (OpenAI-compatible) ---
APP_LLM_BASE_URL=https://api.openai.com/v1
APP_LLM_API_KEY=
APP_LLM_MODEL=gpt-4o-mini
# Optional. Leave empty to mark costs as price_missing; set both to enable cost accounting.
# APP_LLM_INPUT_PRICE_PER_1K=0.0011
# APP_LLM_OUTPUT_PRICE_PER_1K=0.0043
APP_LLM_TIMEOUT_SECONDS=90
APP_LLM_MAX_RETRIES=2

# --- Hot topic sources (AI topic recommendation) ---
# JSON array. Each item: {"name","type":"rss"|"html","url", selectors...}
# HTML items accept item_selector, title_selector, link_selector, content_selector.
# Leave empty to use the balanced default set: 量子位、爱范儿、少数派、Product Hunt、OpenAI 官方.
# Optional include_keywords filters titles; match_summary=true also searches feed summaries (useful for product-name-only feeds).
# priority_keywords ranks matching items within each source; ties keep feed order.
# APP_HOT_TOPIC_SOURCES=[{"name":"少数派","type":"rss","url":"https://sspai.com/feed","include_keywords":["AI","智能体"],"priority_keywords":["游戏","创作","生活"]}]
# HTML list page example:
# APP_HOT_TOPIC_SOURCES=[{"name":"示例站点","type":"html","url":"https://example.com/news","item_selector":"article.post","title_selector":"h2 a","link_selector":"h2 a","content_selector":"article .body"}]
# Legacy comma-separated RSS list. Used only when APP_HOT_TOPIC_SOURCES is empty.
# APP_HOT_TOPICS_FEEDS=https://www.qbitai.com/feed
# Maximum characters of a single article body fetched after topic selection.
APP_TOPIC_ARTICLE_MAX_CHARS=4000

# --- Optional Memecub images during platform formatting ---
APP_MEMECUB_ENABLED=false
APP_MEMECUB_API_KEY=
APP_MEMECUB_TIMEOUT_SECONDS=8

# --- Search ---
# Free HTML search engines used directly (no MCP, no API key), tried in order.
# Supported: baidu, bing (cn.bing.com), 360 (so.com), wechat (Sogou WeChat articles),
# duckduckgo, google. Inside mainland China baidu/bing/360 work; wechat is a vertical
# search over mp.weixin.qq.com articles; duckduckgo/google usually time out.
# Leave empty to disable free engines.
APP_SEARCH_ENGINES=baidu,bing,360
# Optional JSON endpoint returning {"results": [{title,url,snippet,published_at}]}.
# When set it is tried first; the free engines above remain the fallback.
APP_SEARCH_ENDPOINT=
APP_SEARCH_API_KEY=
APP_SEARCH_TIMEOUT_SECONDS=5
APP_SEARCH_MAX_RETRIES=0
# Wall-clock cap for one search query across all engines/retries/redirects.
APP_SEARCH_BUDGET_SECONDS=12
# In-process call protection for the free engines (shared by all search tools).
# Set APP_SEARCH_THROTTLE_ENABLED=false to restore the pre-throttle behavior.
APP_SEARCH_THROTTLE_ENABLED=true
# Minimum seconds between two searches sent to the same engine (0 disables waiting).
APP_SEARCH_MIN_INTERVAL_SECONDS=1
# Reuse that engine's successful results for identical query+limit (0 disables cache).
APP_SEARCH_CACHE_TTL_SECONDS=600
# Skip an engine for this many seconds after it fails (0 disables cooldown).
APP_SEARCH_COOLDOWN_SECONDS=60
# Max engine search requests one search() call may make (cache hits excluded).
APP_SEARCH_MAX_REQUESTS_PER_CALL=6

# --- Deep agents (research / revision) ---
APP_DEEP_RESEARCH_ENABLED=false
APP_DEEP_RESEARCH_MAX_STEPS=5
APP_DEEP_RESEARCH_TIMEOUT_SECONDS=25
APP_DEEP_RESEARCH_MAX_TOKENS=20000
# Hard timeout for the research extraction LLM call(s).
APP_RESEARCH_LLM_TIMEOUT_SECONDS=15
APP_DEEP_REVISION_ENABLED=true
APP_DEEP_REVISION_MAX_STEPS=6
APP_DEEP_REVISION_TIMEOUT_SECONDS=90
APP_DEEP_REVISION_MAX_TOKENS=20000

# --- Tracing (self-hosted Langfuse, disabled by default) ---
# See docs/observability.md for the Docker Compose stack and how to create keys.
APP_LANGFUSE_ENABLED=false
APP_LANGFUSE_HOST=http://127.0.0.1:3000
APP_LANGFUSE_PUBLIC_KEY=
APP_LANGFUSE_SECRET_KEY=
# Sampling rate for traces, 0~1. Keep 1.0 while debugging.
APP_LANGFUSE_SAMPLE_RATE=1.0
# Upper bound for the final flush on shutdown, in seconds.
APP_LANGFUSE_TIMEOUT_SECONDS=5

# --- Scheduled jobs ---
APP_METRICS_INTERVAL_HOURS=6
APP_EVOLUTION_INTERVAL_HOURS=168
APP_EVOLUTION_ENABLED=true
